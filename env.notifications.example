# Shared notification-dispatch pipeline.
NOTIFICATIONS_ENABLED=true
NOTIFICATIONS_BATCH_SIZE=50
NOTIFICATIONS_HTTP_TIMEOUT_SECONDS=30
NOTIFICATIONS_MAX_RETRIES=4
NOTIFICATIONS_RETRY_BASE_SECONDS=30
NOTIFICATIONS_PROCESSING_TIMEOUT_SECONDS=300

# Producer behavior. The intelligence job only writes PENDING rows.
INTELLIGENCE_CREATE_NOTIFICATIONS=false

# Telegram credentials are stored in user_sources.config, not here.
# Example config JSON:
# {"bot_token":"...","chat_id":"...","parse_mode":null}
