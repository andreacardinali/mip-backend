# MIP configuration naming convention
# Format: <DOMAIN>_<COMPONENT>_<PROPERTY>_<UNIT>.
# Use *_ENABLED for booleans, *_LIMIT for maximum counts, *_ORDER for ordered
# provider lists, and explicit units such as *_SECONDS, *_HOURS, and *_DAYS.
# LLM provider-native request options belong in *_LLM_JSON_CONFIG.
# LLM queue settings use *_LLM_QUEUE_*; there is one queue implementation.
# Replace every <REQUIRED_SECRET> placeholder before production deployment.

# APPLICATION AND DATABASE
APP_PORT=5000
DATABASE_URL=postgresql+psycopg://postgres:<REQUIRED_SECRET>@postgresql.internal:5432/market_intelligence
JWT_SECRET=<REQUIRED_SECRET>
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
SCHEDULER_TIMEZONE=Europe/Rome

# LLM PROVIDER PROFILES
LLM_PROFILE_GEMINI_PROVIDER=gemini
LLM_PROFILE_GEMINI_BASE_URL=
LLM_PROFILE_GEMINI_API_KEY=<REQUIRED_SECRET>
LLM_PROFILE_GEMINI_MODEL=gemma-4-31b-it
LLM_PROFILE_GEMINI_JSON_CONFIG={}

LLM_PROFILE_OPENROUTER_PROVIDER=openai_compatible
LLM_PROFILE_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_PROFILE_OPENROUTER_API_KEY=<REQUIRED_SECRET>
LLM_PROFILE_OPENROUTER_MODEL=google/gemma-4-31b-it:free
LLM_PROFILE_OPENROUTER_JSON_CONFIG={}

LLM_PROFILE_GROQ_PROVIDER=openai_compatible
LLM_PROFILE_GROQ_BASE_URL=https://api.groq.com/openai/v1
LLM_PROFILE_GROQ_API_KEY=<REQUIRED_SECRET>
LLM_PROFILE_GROQ_MODEL=openai/gpt-oss-20b
LLM_PROFILE_GROQ_JSON_CONFIG={}

LLM_PROFILE_OLLAMA_PROVIDER=ollama
LLM_PROFILE_OLLAMA_BASE_URL=http://ollama.internal:11434
LLM_PROFILE_OLLAMA_API_KEY=
LLM_PROFILE_OLLAMA_MODEL=qwen3.5:9b
LLM_PROFILE_OLLAMA_JSON_CONFIG={"options":{"num_ctx":8192}}

LLM_PROFILE_NVIDIA_PROVIDER=openai_compatible
LLM_PROFILE_NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_PROFILE_NVIDIA_API_KEY=<REQUIRED_SECRET>
LLM_PROFILE_NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
LLM_PROFILE_NVIDIA_JSON_CONFIG={"chat_template_kwargs":{"enable_thinking":false},"stream":false,"top_p":0.95,"seed":42}

# PORTFOLIO INTELLIGENCE RESEARCH LLM
PORTFOLIO_INTELLIGENCE_LLM_PROVIDER=${LLM_PROFILE_NVIDIA_PROVIDER}
PORTFOLIO_INTELLIGENCE_LLM_BASE_URL=${LLM_PROFILE_NVIDIA_BASE_URL}
PORTFOLIO_INTELLIGENCE_LLM_API_KEY=${LLM_PROFILE_NVIDIA_API_KEY}
PORTFOLIO_INTELLIGENCE_LLM_MODEL=${LLM_PROFILE_NVIDIA_MODEL}
PORTFOLIO_INTELLIGENCE_LLM_JSON_CONFIG=${LLM_PROFILE_NVIDIA_JSON_CONFIG}
PORTFOLIO_INTELLIGENCE_LLM_TIMEOUT_SECONDS=180
PORTFOLIO_INTELLIGENCE_LLM_MAX_RETRIES=3
PORTFOLIO_INTELLIGENCE_LLM_RETRY_MAX_SECONDS=120
PORTFOLIO_INTELLIGENCE_LLM_THINK_ENABLED=false
PORTFOLIO_INTELLIGENCE_LLM_TOKENS_PER_MINUTE=0
PORTFOLIO_INTELLIGENCE_LLM_REQUESTS_PER_MINUTE=30
PORTFOLIO_INTELLIGENCE_LLM_REQUESTS_PER_DAY=0
PORTFOLIO_INTELLIGENCE_LLM_DAILY_RESET_TIMEZONE=America/Los_Angeles
PORTFOLIO_INTELLIGENCE_LLM_RATE_LIMIT_SAFETY_FACTOR=0.90
PORTFOLIO_INTELLIGENCE_LLM_QUEUE_ENABLED=true
PORTFOLIO_INTELLIGENCE_LLM_QUEUE_POLL_SECONDS=1
PORTFOLIO_INTELLIGENCE_LLM_QUEUE_STALE_SECONDS=900
PORTFOLIO_INTELLIGENCE_LLM_QUEUE_WAIT_TIMEOUT_SECONDS=900
PORTFOLIO_INTELLIGENCE_LLM_QUEUE_LEASE_SECONDS=300
PORTFOLIO_INTELLIGENCE_LLM_QUEUE_HEARTBEAT_SECONDS=60
PORTFOLIO_INTELLIGENCE_LLM_QUEUE_MAINTENANCE_INTERVAL_SECONDS=600
PORTFOLIO_INTELLIGENCE_LLM_QUEUE_COMPLETED_RETENTION_DAYS=7
PORTFOLIO_INTELLIGENCE_LLM_QUEUE_FAILED_RETENTION_DAYS=30
PORTFOLIO_INTELLIGENCE_LLM_QUEUE_ABANDONED_RETENTION_DAYS=30
PORTFOLIO_INTELLIGENCE_LLM_CACHE_ENABLED=true
PORTFOLIO_INTELLIGENCE_LLM_CACHE_TTL_SECONDS=21600
PORTFOLIO_INTELLIGENCE_LLM_CACHE_GROUNDED_TTL_SECONDS=1800
PORTFOLIO_INTELLIGENCE_LLM_CACHE_POLL_SECONDS=0.5
PORTFOLIO_INTELLIGENCE_LLM_CACHE_WAIT_TIMEOUT_SECONDS=900
PORTFOLIO_INTELLIGENCE_LLM_CACHE_CLAIM_STALE_SECONDS=900

# PORTFOLIO INTELLIGENCE VALIDATION LLM
PORTFOLIO_INTELLIGENCE_VALIDATION_LLM_PROVIDER=${LLM_PROFILE_OLLAMA_PROVIDER}
PORTFOLIO_INTELLIGENCE_VALIDATION_LLM_BASE_URL=${LLM_PROFILE_OLLAMA_BASE_URL}
PORTFOLIO_INTELLIGENCE_VALIDATION_LLM_API_KEY=${LLM_PROFILE_OLLAMA_API_KEY}
PORTFOLIO_INTELLIGENCE_VALIDATION_LLM_MODEL=${LLM_PROFILE_OLLAMA_MODEL}
PORTFOLIO_INTELLIGENCE_VALIDATION_LLM_JSON_CONFIG=${LLM_PROFILE_OLLAMA_JSON_CONFIG}
PORTFOLIO_INTELLIGENCE_VALIDATION_LLM_TIMEOUT_SECONDS=300
PORTFOLIO_INTELLIGENCE_VALIDATION_LLM_MAX_RETRIES=1
PORTFOLIO_INTELLIGENCE_VALIDATION_LLM_RETRY_MAX_SECONDS=120
PORTFOLIO_INTELLIGENCE_VALIDATION_LLM_THINK_ENABLED=false
PORTFOLIO_INTELLIGENCE_VALIDATION_LLM_QUEUE_ENABLED=false
PORTFOLIO_INTELLIGENCE_VALIDATION_LLM_CACHE_ENABLED=true
PORTFOLIO_INTELLIGENCE_VALIDATION_LLM_CACHE_TTL_SECONDS=604800
PORTFOLIO_INTELLIGENCE_VALIDATION_LLM_CACHE_GROUNDED_TTL_SECONDS=900
PORTFOLIO_INTELLIGENCE_VALIDATION_LLM_CACHE_POLL_SECONDS=0.5
PORTFOLIO_INTELLIGENCE_VALIDATION_LLM_CACHE_WAIT_TIMEOUT_SECONDS=900
PORTFOLIO_INTELLIGENCE_VALIDATION_LLM_CACHE_CLAIM_STALE_SECONDS=900

# PORTFOLIO INTELLIGENCE JOB
PORTFOLIO_INTELLIGENCE_BATCH_SIZE=4
PORTFOLIO_INTELLIGENCE_ETF_HOLDINGS_LIMIT=5
PORTFOLIO_INTELLIGENCE_ECONOMIC_EVENTS_LIMIT=10
PORTFOLIO_INTELLIGENCE_NEWS_LIMIT=10
PORTFOLIO_INTELLIGENCE_NOTIFICATIONS_ENABLED=true
PORTFOLIO_INTELLIGENCE_MARKET_EVIDENCE_ENABLED=true
PORTFOLIO_INTELLIGENCE_UPCOMING_CATALYST_WINDOW_DAYS=7
PORTFOLIO_INTELLIGENCE_BREAKING_CATALYST_LOOKBACK_HOURS=24
PORTFOLIO_INTELLIGENCE_DAILY_MOVE_MIN_PERCENT=3
PORTFOLIO_INTELLIGENCE_MINIMUM_HISTORY_ROWS=50
PORTFOLIO_INTELLIGENCE_HISTORY_RANGE=2y
PORTFOLIO_INTELLIGENCE_HISTORY_INTERVAL=1d

# NEWS ENRICHMENT LLM AND JOB
NEWS_ENRICHMENT_LLM_PROVIDER=${LLM_PROFILE_NVIDIA_PROVIDER}
NEWS_ENRICHMENT_LLM_BASE_URL=${LLM_PROFILE_NVIDIA_BASE_URL}
NEWS_ENRICHMENT_LLM_API_KEY=${LLM_PROFILE_NVIDIA_API_KEY}
NEWS_ENRICHMENT_LLM_MODEL=${LLM_PROFILE_NVIDIA_MODEL}
NEWS_ENRICHMENT_LLM_JSON_CONFIG=${LLM_PROFILE_NVIDIA_JSON_CONFIG}
NEWS_ENRICHMENT_LLM_TIMEOUT_SECONDS=120
NEWS_ENRICHMENT_LLM_MAX_RETRIES=3
NEWS_ENRICHMENT_LLM_RETRY_MAX_SECONDS=120
NEWS_ENRICHMENT_LLM_THINK_ENABLED=false
NEWS_ENRICHMENT_LLM_QUEUE_ENABLED=false
NEWS_ENRICHMENT_LLM_CACHE_ENABLED=true
NEWS_ENRICHMENT_LLM_CACHE_TTL_SECONDS=2592000
NEWS_ENRICHMENT_LLM_CACHE_GROUNDED_TTL_SECONDS=3600
NEWS_ENRICHMENT_LLM_CACHE_POLL_SECONDS=0.5
NEWS_ENRICHMENT_LLM_CACHE_WAIT_TIMEOUT_SECONDS=900
NEWS_ENRICHMENT_LLM_CACHE_CLAIM_STALE_SECONDS=900
NEWS_ENRICHMENT_LIMIT=200
NEWS_ENRICHMENT_BATCH_SIZE=4
NEWS_ENRICHMENT_MAX_OUTPUT_TOKENS=8192

# MARKET ANALYSIS ENRICHMENT LLM AND JOB
MARKET_ANALYSIS_ENRICHMENT_LLM_PROVIDER=${LLM_PROFILE_OLLAMA_PROVIDER}
MARKET_ANALYSIS_ENRICHMENT_LLM_BASE_URL=${LLM_PROFILE_OLLAMA_BASE_URL}
MARKET_ANALYSIS_ENRICHMENT_LLM_API_KEY=${LLM_PROFILE_OLLAMA_API_KEY}
MARKET_ANALYSIS_ENRICHMENT_LLM_MODEL=${LLM_PROFILE_OLLAMA_MODEL}
MARKET_ANALYSIS_ENRICHMENT_LLM_JSON_CONFIG=${LLM_PROFILE_OLLAMA_JSON_CONFIG}
MARKET_ANALYSIS_ENRICHMENT_LLM_TIMEOUT_SECONDS=300
MARKET_ANALYSIS_ENRICHMENT_LLM_MAX_RETRIES=1
MARKET_ANALYSIS_ENRICHMENT_LLM_RETRY_MAX_SECONDS=120
MARKET_ANALYSIS_ENRICHMENT_LLM_THINK_ENABLED=false
MARKET_ANALYSIS_ENRICHMENT_LLM_QUEUE_ENABLED=false
MARKET_ANALYSIS_ENRICHMENT_LLM_CACHE_ENABLED=true
MARKET_ANALYSIS_ENRICHMENT_LLM_CACHE_TTL_SECONDS=604800
MARKET_ANALYSIS_ENRICHMENT_LLM_CACHE_GROUNDED_TTL_SECONDS=900
