# Canonical limit naming
# <DOMAIN>_RUN_MAX_<ENTITIES> limits how many entities one job run selects.
# <DOMAIN>_LLM_REQUEST_MAX_<ENTITIES> limits how many entities one LLM request aggregates.
# <DOMAIN>_LLM_REQUEST_MAX_OUTPUT_TOKENS limits one LLM response.

# Portfolio Intelligence loads all candidates, then aggregates candidates per research request.
PORTFOLIO_INTELLIGENCE_LLM_REQUEST_MAX_CANDIDATES=4

# News Enrichment selects entities for the run, then groups them per LLM request.
NEWS_ENRICHMENT_RUN_MAX_ENTITIES=200
NEWS_ENRICHMENT_LLM_REQUEST_MAX_ENTITIES=4
NEWS_ENRICHMENT_LLM_REQUEST_MAX_OUTPUT_TOKENS=8192

# Market Analysis Enrichment selects signals for the run, then groups them per LLM request.
MARKET_ANALYSIS_ENRICHMENT_RUN_MAX_SIGNALS=25
MARKET_ANALYSIS_ENRICHMENT_LLM_REQUEST_MAX_SIGNALS=1
MARKET_ANALYSIS_ENRICHMENT_LLM_REQUEST_MAX_OUTPUT_TOKENS=500
