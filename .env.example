MARKET_ANALYSIS_ENRICHMENT_CALL_BATCH_SIZE=1
MARKET_ANALYSIS_ENRICHMENT_MAX_OUTPUT_TOKENS=500
MARKET_ANALYSIS_ENRICHMENT_PROMPT_ID=market-analysis-enrichment

# MARKET ANALYSIS SCAN
MARKET_ANALYSIS_UNIVERSE=NASDAQ100
MARKET_ANALYSIS_HISTORY_PERIOD=1y
MARKET_ANALYSIS_BAR_INTERVAL=1d
MARKET_ANALYSIS_MINIMUM_BARS=200
MARKET_ANALYSIS_SIGNAL_TIMEFRAME=1D

# DATA PROVIDERS
FMP_BASE_URL=https://financialmodelingprep.com/stable
FMP_API_KEY=<REQUIRED_SECRET>
FMP_HTTP_TIMEOUT_SECONDS=30
FMP_HTTP_MAX_RETRIES=3
FMP_HTTP_RETRY_BASE_SECONDS=2
FMP_CALENDAR_DAYS_FORWARD=90
FMP_FILINGS_LOOKBACK_DAYS=1
FMP_FILINGS_PAGE_LIMIT=20
OPENFIGI_BASE_URL=https://api.openfigi.com/v3
OPENFIGI_API_KEY=<REQUIRED_SECRET>
OPENFIGI_HTTP_TIMEOUT_SECONDS=15
OPENFIGI_HTTP_MAX_RETRIES=2
OPENFIGI_HTTP_RETRY_BASE_SECONDS=1
EULERPOOL_API_KEY=<REQUIRED_SECRET>
WIKIPEDIA_USER_AGENT=MIP/1.0 (https://github.com/andreacardinali/mip-backend)
WIKIPEDIA_HTTP_TIMEOUT_SECONDS=30
APEWISDOM_USER_AGENT=MIP/1.0
APEWISDOM_HTTP_TIMEOUT_SECONDS=30
ECB_HTTP_TIMEOUT_SECONDS=30
ECB_HTTP_MAX_RETRIES=2
