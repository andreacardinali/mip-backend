# Shared HTTP retry semantics: MAX_RETRIES is retries after the initial attempt.

MARKET_DATA_HTTP_MAX_RETRIES=3
MARKET_DATA_HTTP_RETRY_BASE_SECONDS=1

EXCHANGE_RATES_HTTP_MAX_RETRIES=3
EXCHANGE_RATES_HTTP_RETRY_BASE_SECONDS=1

# Existing FMP variables are reused by the shared retry component.
FMP_HTTP_MAX_RETRIES=3
FMP_HTTP_RETRY_DELAY=2
